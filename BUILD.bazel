"""sonic-mgmt-common Debian packages — migrated from rules/sonic-mgmt-common.mk."""

load("//rules/bazel/deb:deb.bzl", "deb_package_set")

package(default_visibility = ["//visibility:public"])

deb_package_set(
    name = "mgmt_common_debs",
    srcs = glob(
        ["**/*"],
        exclude = [
            ".git/**",
            "BUILD.bazel",
        ],
    ),
    build_deps = [],
    debian_dir = "debian",
    declared_outputs = [
        "sonic-mgmt-common_1.0.0_$(ARCH).deb",
        "sonic-mgmt-common-codegen_1.0.0_$(ARCH).deb",
    ],
    version = "1.0.0",
    visibility = ["//visibility:public"],
)

alias(
    name = "mgmt_common",
    actual = ":mgmt_common_debs",
    visibility = ["//visibility:public"],
)

alias(
    name = "mgmt_common_codegen",
    actual = ":mgmt_common_debs",
    visibility = ["//visibility:public"],
)
